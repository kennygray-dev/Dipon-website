# Contact form (Resend). Copy this file to .env.local and fill in RESEND_API_KEY.
# The same three variables must also be set in the Vercel project (Production).
#
#   RESEND_API_KEY      — from resend.com → API keys (sending access). Secret.
#   CONTACT_TO_EMAIL    — where enquiries are delivered.
#   CONTACT_FROM_EMAIL  — verified "from" address; replies go to the visitor.

RESEND_API_KEY=
CONTACT_TO_EMAIL=info@dipongrouplimited.com
CONTACT_FROM_EMAIL="DIPON Group <no-reply@dipongrouplimited.com>"

# Blog CMS (Sanity). These have fallbacks in src/sanity/env.ts, so they're
# optional overrides. Add a read token only if the dataset is set to private.
NEXT_PUBLIC_SANITY_PROJECT_ID=k9qxpd0n
NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
