# Contact form (Resend) — copy this file to .env.local and fill in real values.
#
# 1. Create a free account at https://resend.com and make an API key.
# 2. Paste the key below.
# 3. Set CONTACT_TO_EMAIL to wherever enquiries should land (any inbox works —
#    e.g. a Gmail while you wait for the official DIPON address).
# 4. Leave CONTACT_FROM_EMAIL unset to use Resend's shared test sender. Once the
#    DIPON domain is verified in Resend, set it to something like
#    "DIPON Group <hello@dipongroup.com>".

RESEND_API_KEY=
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL="DIPON Group <hello@dipongroup.com>"
